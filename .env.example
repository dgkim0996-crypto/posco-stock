PORT=3001
HOST=0.0.0.0
# 쉼표로 구분한 허용 프런트 주소입니다. Secret이 아니며 마지막 /는 생략합니다.
CLIENT_URLS=http://localhost:5173,https://posco-stock.vercel.app

# 별도 Express 서버를 배포한 뒤 Vercel 빌드 환경변수에 공개 HTTPS/WSS 주소를 등록합니다.
# 로컬에서는 비워 두면 Vite가 localhost:3001로 프록시합니다.
VITE_API_BASE_URL=
VITE_WS_BASE_URL=

# Supabase 프로젝트 Settings > API에서 확인합니다.
# Secret key는 서버 전용이며 VITE_ 접두사를 붙이거나 브라우저 코드에 넣지 않습니다.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-secret-key

# React 로그인 전용 공개 키입니다. Secret key를 VITE_ 변수에 넣지 마세요.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# 기존 Supabase 프로젝트라면 아래 legacy 키 이름도 지원합니다.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# true로 바꾸기 전에 supabase/migrations/001_initial_accounts.sql을 실행하세요.
SUPABASE_ENABLED=false

# 외부 호출 보호 한도 (필요 시 운영 환경에 맞춰 조정)
ADVISOR_RATE_LIMIT_MAX=5
STOCK_IMAGE_RATE_LIMIT_MAX=120

# 선택 기능: 등록하지 않으면 해당 외부 데이터/AI 기능만 사용할 수 없습니다.
KIS_APP_KEY=your-kis-app-key
KIS_APP_SECRET=your-kis-app-secret
KIS_ENV=paper
# 원격 WebSocket 검증 시에만 설정합니다. 로컬 테스트는 비워 둡니다.
KIS_WS_TEST_URL=
KIS_WS_TEST_SYMBOL=005930
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4.1-mini
BOK_ECOS_API_KEY=your-ecos-api-key
